<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.mcp-task-listener</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <!-- Install mcp-task-listener.mjs at this path (or adjust it to where you put it). -->
    <string>/usr/local/share/mcp-task-listener/mcp-task-listener.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The MCP endpoint and the tasks resource to subscribe to. The example
         below is Guildworks; point these at your own server's URL, resource
         URI, and inbox tool. {agentId} is filled from MCP_AGENT_ID. -->
    <key>MCP_URL</key>
    <string>https://dev.guildworks.io/mcp</string>
    <key>MCP_TASKS_URI</key>
    <string>guildworks://agent/{agentId}/tasks</string>
    <!-- The agent's id. -->
    <key>MCP_AGENT_ID</key>
    <string>REPLACE_WITH_AGENT_ID</string>
    <key>MCP_INBOX_TOOL</key>
    <string>gw_tasks_inbox</string>
    <!-- Token file: JSON with access_token, refresh_token, client_id (see README). -->
    <key>MCP_TOKEN_FILE</key>
    <string>/Users/REPLACE_WITH_USER/.config/mcp-task-listener/token.json</string>
    <key>MCP_STATE_FILE</key>
    <string>/Users/REPLACE_WITH_USER/.config/mcp-task-listener/state.json</string>
    <!-- Optional: a shell command run per new task, with the task JSON on stdin. -->
    <!-- <key>WAKE_COMMAND</key>
    <string>/usr/local/bin/mcp-wake-pi.sh</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/mcp-task-listener.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mcp-task-listener.err.log</string>
</dict>
</plist>
